# Git for Windows defaults to CRLF; the workflow runners are Linux and will not
# execute a shell script that has carriage returns in it.
* text=auto
*.sh  text eol=lf
*.py  text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md  text eol=lf
*.ps1 text eol=crlf

# The news logs are append-only. Both workflows can push in the same minute,
# and a union merge keeps both sets of lines instead of failing the rebase.
state/news/*.jsonl merge=union
