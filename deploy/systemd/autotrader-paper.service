[Unit]
Description=Alpaca paper ETF momentum rebalance
Documentation=file:/opt/auto-trader/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/auto-trader/python
EnvironmentFile=/etc/auto-trader/env
ExecStart=/opt/auto-trader/deploy/run-paper.sh
TimeoutStartSec=15min
Nice=5
