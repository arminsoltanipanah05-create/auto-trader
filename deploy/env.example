# Alpaca PAPER keys. Generate at https://app.alpaca.markets/paper/dashboard/overview
# Paper key IDs start with PK.
#
# This file is read by systemd (as root, before dropping privileges to `trader`),
# so it can stay mode 600 and root-owned.
#
#   sudo nano /etc/auto-trader/env
#   sudo chmod 600 /etc/auto-trader/env
#
# No quotes, no spaces around '='.

APCA_API_KEY_ID=PK_REPLACE_ME
APCA_API_SECRET_KEY=REPLACE_ME
