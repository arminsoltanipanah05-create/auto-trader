# Python
__pycache__/
*.pyc
python/.venv/
python/.venv-torch/
.venv/
.venv-torch/

# Downloaded market data (large, and regenerated on demand)
python/data/cache/
python/data/liquid/

# Local run artefacts
logs/
*.log

# The trade marker is committed on purpose - it is how the bot remembers it
# already traded today when the machine running it is ephemeral.
!state/last-trade.txt

# Live-trade approval tokens: created by a human, consumed once, never committed
state/approvals/

# The news log is committed on purpose: it is how novelty, dedupe and the
# review loop remember anything between the ephemeral CI runners. These two are
# derived or regenerated, so they stay local.
state/news/cik_map.json
state/news/review.json
