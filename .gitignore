# Python
__pycache__/
*.pyc
python/.venv/
python/.venv-torch/
.venv/
.venv-torch/

# Downloaded market data (large, and regenerated on demand)
python/data/cache/
python/data/liquid/

# Local run artefacts
logs/
*.log

# The trade marker is committed on purpose - it is how the bot remembers it
# already traded today when the machine running it is ephemeral.
!state/last-trade.txt

# Live-trade approval tokens: created by a human, consumed once, never committed
state/approvals/

# News layer runtime state (append-only decision/event logs, learned weights).
# Local history is the input to news_review.py; it is not traded between machines.
state/news/
